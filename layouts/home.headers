{{- $a := partialCached "assets.html" . -}}
{{- $base := (urls.Parse site.BaseURL).Path | strings.TrimSuffix "/" -}}
# Generated by layouts/home.headers. The script hash is the inline boot
# script's, computed at build time, so the policy can't drift from the code.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' '{{ $a.boot.Data.Integrity }}'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; media-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), browsing-topics=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin

{{ $base }}/css/*
  Cache-Control: public, max-age=31536000, immutable

{{ $base }}/js/*
  Cache-Control: public, max-age=31536000, immutable

{{ $base }}/themes/*
  Cache-Control: public, max-age=604800
